rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTask(data) {
      return data.keys().hasOnly([
          'title', 'description', 'startDate', 'endDate', 'type', 'targetCount', 'count',
          'completed', 'schemaVersion', 'tagIds', 'recurrence', 'seriesState',
          'currentOccurrenceKey', 'occurrenceSequence', 'lastAdvanceMutationId',
          'parentTaskId', 'occurrenceKey',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'title', 'startDate', 'endDate', 'type', 'targetCount', 'count',
          'completed', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && (!('description' in data)
          || (data.description is string && data.description.size() <= 2000))
        && data.startDate is string
        && data.endDate is string
        && (data.startDate.size() == 0
          || (data.startDate.size() >= 10 && data.startDate.size() <= 16))
        && (data.endDate.size() == 0
          || (data.endDate.size() >= 10 && data.endDate.size() <= 16))
        && data.type in ['single', 'progress']
        && data.targetCount is int
        && data.count is int
        && data.completed is bool
        && (!('schemaVersion' in data) || (data.schemaVersion is int && data.schemaVersion in [1, 2, 3]))
        && (!('tagIds' in data) || (data.tagIds is list && data.tagIds.size() <= 10))
        && (!('recurrence' in data) || validRecurrence(data.recurrence, data.startDate, data.endDate))
        && (!('seriesState' in data) || data.seriesState == null || data.seriesState in ['active', 'ended'])
        && (!('currentOccurrenceKey' in data) || data.currentOccurrenceKey == null || data.currentOccurrenceKey is string)
        && (!('occurrenceSequence' in data) || (data.occurrenceSequence is int && data.occurrenceSequence >= 0))
        && (!('lastAdvanceMutationId' in data) || data.lastAdvanceMutationId == null || data.lastAdvanceMutationId is string)
        && (!('parentTaskId' in data) || data.parentTaskId is string)
        && (!('occurrenceKey' in data) || data.occurrenceKey is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (data.type == 'single'
            && data.targetCount == 0
            && data.count == 0)
          ||
          (data.type == 'progress'
            && data.targetCount >= 1
            && data.targetCount <= 99999
            && data.count >= 0
            && data.count <= data.targetCount
            && data.completed == false)
        );
    }

    function validRecurrence(recurrence, startDate, endDate) {
      return recurrence == null
        || (
          recurrence is map
          && startDate.size() >= 10
          && endDate.size() >= 10
          && recurrence.keys().hasOnly([
            'frequency', 'interval', 'byWeekdays', 'byMonth', 'byMonthDay', 'end',
            'timeZone', 'anchorStart', 'durationMinutes'
          ])
          && recurrence.keys().hasAll([
            'frequency', 'interval', 'end', 'timeZone', 'anchorStart', 'durationMinutes'
          ])
          && recurrence.frequency in ['hourly', 'daily', 'weekly', 'monthly', 'yearly']
          && recurrence.interval is int
          && recurrence.interval >= 1
          && recurrence.interval <= 999
          && (!('byWeekdays' in recurrence)
            || (recurrence.byWeekdays is list
              && recurrence.byWeekdays.size() >= 1
              && recurrence.byWeekdays.size() <= 7))
          && (!('byMonthDay' in recurrence)
            || (recurrence.byMonthDay is int
              && recurrence.byMonthDay >= 1
              && recurrence.byMonthDay <= 31))
          && (!('byMonth' in recurrence)
            || (recurrence.byMonth is int
              && recurrence.byMonth >= 1
              && recurrence.byMonth <= 12))
          && recurrence.end is map
          && recurrence.end.keys().hasOnly(['kind', 'date'])
          && recurrence.end.kind in ['never', 'until']
          && (recurrence.end.kind == 'never'
            || ('date' in recurrence.end
              && recurrence.end.date is string
              && recurrence.end.date.size() == 10))
          && recurrence.timeZone is string
          && recurrence.timeZone.size() > 0
          && recurrence.timeZone.size() <= 80
          && recurrence.anchorStart is string
          && recurrence.anchorStart.size() >= 10
          && recurrence.durationMinutes is int
          && recurrence.durationMinutes >= 0
        );
    }

    function validLog(data) {
      return data.keys().hasOnly(['type', 'action', 'payload', 'scope', 'occurrenceKey', 'seq', 'createdAt'])
        && data.keys().hasAll(['type', 'action', 'payload', 'createdAt'])
        && data.type in ['create', 'update', 'progress', 'recurrence', 'tag', 'type', 'status', 'roll']
        && data.action is string
        && data.action.size() > 0
        && data.action.size() <= 120
        && data.payload is map
        && (!('scope' in data) || data.scope in ['series', 'occurrence'])
        && (!('occurrenceKey' in data) || data.occurrenceKey is string)
        && (!('seq' in data) || data.seq is int)
        && data.createdAt is timestamp;
    }

    function validTag(data) {
      return data.keys().hasOnly([
          'name', 'normalizedName', 'color', 'sortOrder', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.keys().hasAll([
          'name', 'normalizedName', 'color', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 24
        && data.normalizedName is string
        && data.normalizedName.size() > 0
        && data.normalizedName.size() <= 72
        && data.color in ['lavender', 'mint', 'apricot', 'rose', 'sky', 'amber', 'slate', 'indigo']
        && data.sortOrder is int
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('deletedAt' in data) || data.deletedAt is timestamp);
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTask(request.resource.data);

      match /logs/{logId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validLog(request.resource.data);
        allow update: if false;
      }

      match /occurrences/{occurrenceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'occurrenceKey', 'result', 'scheduledStart', 'scheduledEnd', 'count',
            'targetCount', 'title', 'tagIds', 'completedAt', 'mutationId', 'createdAt'
          ])
          && request.resource.data.occurrenceKey is string
          && request.resource.data.result in ['completed', 'skipped']
          && request.resource.data.scheduledStart is string
          && request.resource.data.scheduledEnd is string
          && request.resource.data.count is int
          && request.resource.data.targetCount is int
          && request.resource.data.title is string
          && request.resource.data.tagIds is list
          && request.resource.data.completedAt is string
          && request.resource.data.mutationId is string
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
      }
    }

    match /users/{userId}/settings/{settingId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && settingId == 'preferences'
        && request.resource.data.keys().hasOnly(['hideCompleted', 'updatedAt'])
        && request.resource.data.hideCompleted is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /users/{userId}/tags/{tagId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTag(request.resource.data);
    }

    match /users/{userId}/tagNameClaims/{nameKey} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['tagId', 'normalizedName', 'createdAt'])
        && request.resource.data.keys().hasAll(['tagId', 'normalizedName', 'createdAt'])
        && request.resource.data.tagId is string
        && request.resource.data.normalizedName is string
        && request.resource.data.createdAt is timestamp;
    }
  }
}
